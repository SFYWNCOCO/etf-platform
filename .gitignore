_*.py
_*.json
quick_diag*.py
sanity_check.py
deep_analysis.py
focused_analysis.py
diagnostic*.py
check_*.py
batch_diverse.py
update_groups.py
sync_check.py
test_inference.py

# Config backups
config/*.bak*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
